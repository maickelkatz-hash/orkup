# Copy this file to .env.local and fill in the values from your Supabase
# project settings (Project Settings > API).
#
# NEXT_PUBLIC_ variables are exposed to the browser — never put secret
# keys (like the service_role key) in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
