# Copy this file to .env.local and fill in the values from your Supabase
# project settings (Project Settings > API).
#
# NEXT_PUBLIC_ variables are exposed to the browser — never put secret
# keys (like the service_role key) in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# URL pública do site — usada para montar o link de confirmação de e-mail
# que o Supabase envia. Na Vercel, defina como https://SEU-DOMINIO.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
